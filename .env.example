# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string (when using full PostgreSQL database)
DATABASE_URL="postgresql://user:password@localhost:5432/founder_intelligence"

# SEARCH_API_KEY: Optional external research search API key (Tavily, Serper, Exa, etc.)
SEARCH_API_KEY=""

# FIRECRAWL_API_KEY: Optional web scraping engine API key
FIRECRAWL_API_KEY=""

# AUTH_SECRET: Secret for signing JWT / authentication tokens
AUTH_SECRET="founder_ai_secret_jwt_key_development_only"

# STRIPE_SECRET_KEY: Optional Stripe API key for subscription billing
STRIPE_SECRET_KEY=""
